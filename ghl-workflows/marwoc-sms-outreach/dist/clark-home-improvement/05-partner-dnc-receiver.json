{
  "name": "MARWOC | 05 DNC Sync Receiver (from SFI Investing)",
  "status": "draft",
  "version": 1,
  "timezone": "account",
  "stopOnResponse": false,
  "allowMultiple": true,
  "removeContactFromLastStep": true,
  "autoMarkAsRead": false,
  "triggers": [
    {
      "type": "inbound_webhook",
      "name": "Inbound webhook from SFI Investing",
      "active": true,
      "conditions": []
    }
  ],
  "workflowData": {
    "templates": [
      {
        "id": "728a8e51-46f1-52f0-9628-174edbb690c9",
        "order": 0,
        "name": "Find or create contact by phone",
        "type": "create_update_contact",
        "attributes": {
          "matchBy": "phone",
          "fields": {
            "phone": "{{inboundWebhookRequest.phone}}",
            "email": "{{inboundWebhookRequest.email}}",
            "first_name": "{{inboundWebhookRequest.first_name}}",
            "last_name": "{{inboundWebhookRequest.last_name}}"
          }
        },
        "parentKey": null,
        "next": "ab124c58-e245-5c71-8fd5-5b413da59dff"
      },
      {
        "id": "ab124c58-e245-5c71-8fd5-5b413da59dff",
        "order": 1,
        "name": "DND: all channels",
        "type": "dnd_contact",
        "attributes": {
          "dnd": true,
          "channels": [
            "all"
          ]
        },
        "parentKey": "728a8e51-46f1-52f0-9628-174edbb690c9",
        "next": "166a2408-addb-569e-a1e9-320a2dfbd52f"
      },
      {
        "id": "166a2408-addb-569e-a1e9-320a2dfbd52f",
        "order": 2,
        "name": "Add tag: dnc-permanent, dnc-synced-from-partner",
        "type": "add_contact_tag",
        "attributes": {
          "tags": [
            "dnc-permanent",
            "dnc-synced-from-partner"
          ]
        },
        "parentKey": "ab124c58-e245-5c71-8fd5-5b413da59dff",
        "next": "d7e5b819-57d1-5d8a-aab0-43ec4c37ce2a"
      },
      {
        "id": "d7e5b819-57d1-5d8a-aab0-43ec4c37ce2a",
        "order": 3,
        "name": "Audit note: partner opt-out",
        "type": "add_note",
        "attributes": {
          "body": "Opted out in {{inboundWebhookRequest.source_account}} ({{inboundWebhookRequest.reason}}). Suppressed here automatically."
        },
        "parentKey": "166a2408-addb-569e-a1e9-320a2dfbd52f",
        "next": "b6d5ff19-50dc-5f25-b7a2-5d242ba74e54"
